+def _max_age_to_seconds(max_age: int | float | timedelta | None) -> float | None:
+    """Convert a max_age argument to seconds as a float.
+
+    Accepts ``int``, ``float``, or ``datetime.timedelta`` values.
+    Returns ``None`` when ``max_age`` is ``None``.
+    """
+    if max_age is None:
+        return None
+    if isinstance(max_age, timedelta):
+        return max_age.total_seconds()
+    return float(max_age)
+
