diff --git a/candidate.c b/candidate.c
index 98c444a915d0f839398f7db6061ee499cf4e6b6b..34b4bea302664f2c6e7bb8fdbaf5f58dcc66c594 100644
--- a/candidate.c
+++ b/candidate.c
@@ -1 +1,21 @@
-int main(void) { return 1; }
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int main(int argc, char *argv[]) {
+    if (argc < 3) {
+        fprintf(stderr, "usage\n");
+        return 2;
+    }
+    long step = strtol(argv[2], NULL, 10);
+    size_t len = strlen(argv[1]);
+    if (len > 0 && step > (long)len) {
+        fprintf(stderr, "step\n");
+        return 3;
+    }
+    for (size_t i = 0; i < len; i += step) {
+        putchar(argv[1][i]);
+    }
+    putchar('\n');
+    return 0;
+}
