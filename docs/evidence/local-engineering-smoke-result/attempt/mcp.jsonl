{"tool": "focus", "index": null, "call": 2, "path": "test_units.py", "sha256": "3270b12ed8619445d9ebfbe9e28959b0cce69c708db667568b9684e176847c29", "line": 1, "source": "import unittest\n\nfrom units import fahrenheit_to_celsius\n\n\nclass ConversionTests(unittest.TestCase):\n    def test_freezing(self):\n        self.assertAlmostEqual(fahrenheit_to_celsius(32), 0)\n\n    def test_boiling(self):\n        self.assertAlmostEqual(fahrenheit_to_celsius(212), 100)\n\n    def test_negative(self):\n        self.assertAlmostEqual(fahrenheit_to_celsius(-40), -40)\n\n    def test_fraction(self):\n        self.assertAlmostEqual(fahrenheit_to_celsius(98.6), 37)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n", "next_line": null, "total_lines": 21, "selected_symbol": "", "symbols": [{"symbol": "ConversionTests", "line": 6, "end_line": 17, "kind": "class"}, {"symbol": "ConversionTests.test_freezing", "line": 7, "end_line": 8, "kind": "function"}, {"symbol": "ConversionTests.test_boiling", "line": 10, "end_line": 11, "kind": "function"}, {"symbol": "ConversionTests.test_negative", "line": 13, "end_line": 14, "kind": "function"}, {"symbol": "ConversionTests.test_fraction", "line": 16, "end_line": 17, "kind": "function"}], "symbols_truncated": false, "context_epoch": 0, "evidence_key": "f692071e1e349971fe075b07a9a5c81ceadcd6f5ed1e1e07356ec7650c61782c", "passed": true, "stdout": "", "stderr": "", "objective": "Fix the Fahrenheit to Celsius conversion in units.py using the standard formula. Inspect units.py and test_units.py, preserve the existing interface and execute public check 0. Only units.py may change.", "objective_truncated": false, "write_roots": ["units.py"], "remaining_calls": 18, "resource_status": {"epoch": 0, "remaining_operations": 18, "used": {"inspection": 2, "editing": 0, "verification": 0, "inference": 1, "compaction": 0}, "exhausted": "", "policy": {"operations": 20, "edit_reserve": 4, "verification_reserve": 4, "model_requests": 12, "compactions": 1, "blo