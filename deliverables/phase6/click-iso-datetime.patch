+import datetime
+import typing as t
+from unittest import mock
+
+import click
+import pytest
+
+
+class TestISODateTime:
+    """Tests for the new ISODateTime parameter type."""
+
+    def test_basic_conversion(self):
+        """Test basic conversion of an ISO 8601 string to a datetime object."""
+        iso_type = click.ISODateTime()
+        result = iso_type.convert("2023-01-01T12:00:00", None, None)
+        assert isinstance(result, datetime.datetime)
+        assert result.year == 2023
+        assert result.month == 1
+        assert result.day == 1
+
+    def test_naive_datetime_rejected(self):
+        """Test that naive datetimes are rejected when require_timezone=True."""
+        iso_type = click.ISODateTime(require_timezone=True)
+        with pytest.raises(click.BadParameter, match="timezone"):
+            iso_type.convert(datetime.datetime(2023, 1, 1), None, None)
+
+    def test_aware_datetime_normalized_to_utc(self):
+        """Test that aware datetimes are normalized to UTC when normalize_to_utc=True."""
+        tz = datetime.timezone.utc
+        iso_type = click.ISODateTime(normalize_to_utc=True)
+        result = iso_type.convert("2023-01-01T12:00:00+05:00", None, None)
+        assert isinstance(result, datetime.datetime)
+        assert result.tzinfo is not None
+        assert result.utcoffset() == datetime.timedelta(0)
+
+    def test_combined_flags(self):
+        """Test combined require_timezone=True and normalize_to_utc=True."""
+        iso_type = click.ISODateTime(require_timezone=True, normalize_to_utc=True)
+        # Valid aware datetime should pass
+        result = iso_type.convert("2023-01-01T12:00:00+05:00", None, None)
+        assert isinstance(result, datetime.datetime)
+        assert result.tzinfo is not None
+        # Naive datetime should fail
+        with pytest.raises(click.BadParameter, match="timezone"):
+            iso_type.convert(datetime.datetime(2023, 1, 1), None, None)
+
+    def test_invalid_string_raises(self):
+        """Test that invalid strings raise BadParameter."""
+        iso_type = click.ISODateTime()
+        with pytest.raises(click.BadParameter, match="ISO 8601"):
+            iso_type.convert("not a datetime", None, None)
+
+    def test_cli_integration(self):
+        """Test CLI integration with ISODateTime parameter type."""
+        from click.testing import CliRunner
+
+        @click.command()
+        @click.option("--dt", type=click.ISODateTime(require_timezone=True))
+        def cli(dt):
+            click.echo(dt.isoformat())
+
+        runner = CliRunner()
+
+        # Test valid input with timezone
+        result = runner.invoke(cli, ["--dt=2023-01-01T12:00:00+00:00"])
+        assert not result.exception
+        assert result.exit_code == 0
+        assert "2023-01-01T12:00:00+00:00" in result.output
+
+        # Test valid input with Z timezone
+        result = runner.invoke(cli, ["--dt=2023-01-01T12:00:00Z"])
+        assert not result.exception
+        assert result.exit_code == 0
+
+        # Test invalid input - missing timezone
+        result = runner.invoke(cli, ["--dt=2023-01-01T12:00:00"])
+        assert result.exit_code == 2
+        assert "Invalid value for '--dt'" in result.output
+
+        # Test invalid input - malformed string
+        result = runner.invoke(cli, ["--dt=invalid"])
+        assert result.exit_code == 2
+        assert "Invalid value for '--dt'" in result.output
+
+    def test_to_info_dict(self):
+        """Test that to_info_dict includes constructor flags."""
+        iso_type = click.ISODateTime(require_timezone=True, normalize_to_utc=False)
+        info_dict = iso_type.to_info_dict()
+        assert info_dict["param_type"] == "ISODateTime"
+        assert info_dict["name"] == "iso_datetime"
+        assert info_dict["require_timezone"] is True
+        assert info_dict["normalize_to_utc"] is False
