+class ISODateTime(ParamType):
+    """The ISODateTime type converts ISO 8601 datetime strings into `datetime` objects.
+
+    Uses ``datetime.fromisoformat`` for parsing with support for timezone handling flags.
+
+    :param require_timezone: If True, reject naive datetime objects (offset is None).
+    :param normalize_to_utc: If True, convert aware datetimes to UTC.
+    """
+
+    name = "iso_datetime"
+
+    def __init__(
+        self,
+        require_timezone: bool = False,
+        normalize_to_utc: bool = False,
+    ):
+        self.require_timezone = require_timezone
+        self.normalize_to_utc = normalize_to_utc
+
+    def to_info_dict(self) -> dict[str, t.Any]:
+        info_dict = super().to_info_dict()
+        info_dict.update(
+            require_timezone=self.require_timezone,
+            normalize_to_utc=self.normalize_to_utc,
+        )
+        return info_dict
+
+    def get_metavar(self, param: Parameter, ctx: Context) -> str | None:
+        return "ISO_DATETIME"
+
+    def convert(
+        self, value: t.Any, param: Parameter | None, ctx: Context | None
+    ) -> t.Any:
+        if isinstance(value, datetime):
+            # Already a datetime object; validate and normalize as needed
+            return self._handle_datetime(value, param, ctx)
+
+        if not isinstance(value, str):
+            self.fail(
+                f"{value!r} is not a valid ISO 8601 datetime string or datetime object.",
+                param,
+                ctx,
+            )
+
+        # Parse using fromisoformat with various common separators
+        parsed = None
+        for separator in ["-", " ", "T"]:
+            try:
+                parsed = datetime.fromisoformat(value)
+                break
+            except ValueError:
+                continue
+
+        if parsed is None:
+            self.fail(
+                f"{value!r} is not a valid ISO 8601 datetime string.",
+                param,
+                ctx,
+            )
+
+        # Apply timezone handling flags
+        return self._handle_datetime(parsed, param, ctx)
+
+    def _handle_datetime(
+        self, value: datetime, param: Parameter | None, ctx: Context | None
+    ) -> datetime:
+        # Check if naive or aware (tzinfo present but utcoffset is None counts as naive)
+        tzinfo = value.tzinfo
+        is_naive = tzinfo is None or (tzinfo is not None and tzinfo.utcoffset(value) is None)
+
+        # If require_timezone=True and value is naive, fail
+        if self.require_timezone and is_naive:
+            self.fail(
+                f"{value!r} is a naive datetime (no timezone) but require_timezone=True. "
+                "ISO 8601 datetime values must include a timezone when this flag is set.",
+                param,
+                ctx,
+            )
+
+        # If normalize_to_utc=True and value is aware, convert to UTC; if naive, fail
+        if self.normalize_to_utc:
+            if is_naive:
+                self.fail(
+                    f"{value!r} is a naive datetime (no timezone) but normalize_to_utc=True. "
+                    "ISO 8601 datetime values must be aware when this flag is set.",
+                    param,
+                    ctx,
+                )
+
+            # Convert to UTC
+            utc_value = value.astimezone(timezone.utc)
+            return utc_value
+
+        return value
+
+    def __repr__(self) -> str:
+        return "ISODateTime"
+
+
